# =====================================================================
#  NEVADA BREEZE — Apache / LiteSpeed rules
# =====================================================================

# ---- Seguridad: bloquear acceso directo a archivos sensibles --------
<FilesMatch "^(config\.secret\.php|config\.php|composer\.(json|lock)|.*\.log)$">
    Require all denied
</FilesMatch>

# ---- Páginas de error -----------------------------------------------
ErrorDocument 404 /404.php

# ---- Compresión y caché ---------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css            "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png           "access plus 1 year"
    ExpiresByType image/jpeg          "access plus 1 year"
    ExpiresByType image/webp          "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- 1. Forzar HTTPS + www (un solo salto 301) ------------------
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.nevadabreezehvac.com%{REQUEST_URI} [L,R=301]

    # ---- 2. Servir /sitemap.xml desde sitemap.php -------------------
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # ---- 3. Redirecciones de rutas antiguas (301) -------------------
    RedirectMatch 301 ^/procesar_correo\.php$ /contact
    RedirectMatch 301 ^/index\.php$ /
    RedirectMatch 301 ^/process\.php$ /contact

    # ---- 4. URLs limpias: ocultar la extensión .php -----------------
    # Redirige /pagina.php -> /pagina (canonical)
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Reescribe internamente /pagina -> /pagina.php si el archivo existe
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
